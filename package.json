{
  "name": "@ojoho/fractaljs",
  "version": "0.9.0",
  "description": "A tiny JavaScript library for modern DOM manipulation and event handling",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js",
    "typecheck": "tsc -p src/jsconfig.json",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test"
  },
  "keywords": [
    "javascript",
    "dom",
    "events",
    "animation",
    "library",
    "frontend",
    "browser"
  ],
  "author": "scottlet <scott@ojoho.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scottlet/FractalJS.git"
  },
  "bugs": {
    "url": "https://github.com/scottlet/FractalJS/issues"
  },
  "homepage": "https://github.com/scottlet/FractalJS#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsdoc": "^62.6.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "happy-dom": "^20.6.1",
    "jsdoc": "^4.0.5",
    "prettier": "^3.8.1",
    "rollup": "^4.57.1",
    "tsd-jsdoc": "^2.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "debounce": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "packageManager": "pnpm@10.30.0"
}
